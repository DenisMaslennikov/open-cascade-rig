{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Cascade plan",
  "type": "object",
  "required": [
    "task",
    "subtasks"
  ],
  "additionalProperties": false,
  "properties": {
    "task": {
      "type": "object",
      "required": [
        "id",
        "title",
        "goal",
        "acceptance_summary"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]{2,40}$"
        },
        "title": {
          "type": "string",
          "minLength": 3,
          "maxLength": 120
        },
        "goal": {
          "type": "string",
          "minLength": 10
        },
        "acceptance_summary": {
          "type": "string",
          "minLength": 10
        }
      }
    },
    "subtasks": {
      "type": "array",
      "minItems": 1,
      "maxItems": 12,
      "items": {
        "type": "object",
        "required": [
          "id",
          "title",
          "goal",
          "files_allowed",
          "acceptance",
          "depends_on"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]{1,30}$"
          },
          "title": {
            "type": "string",
            "minLength": 3,
            "maxLength": 120
          },
          "goal": {
            "type": "string",
            "minLength": 10
          },
          "files_allowed": {
            "type": "array",
            "minItems": 1,
            "maxItems": 6,
            "items": {
              "type": "string",
              "pattern": "^((backend|frontend)/)?(src|tests|app|lib|pkg|tools|docs|scripts|bin|alembic)/[^\\s]+$|^(alembic\\.ini|pyproject\\.toml|requirements[^/\\s]*\\.txt)$"
            }
          },
          "contract": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "new_signatures": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "breaks": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          },
          "acceptance": {
            "type": "array",
            "minItems": 1,
            "maxItems": 8,
            "items": {
              "type": "object",
              "required": [
                "in",
                "out"
              ],
              "additionalProperties": false,
              "properties": {
                "in": {
                  "type": "string"
                },
                "out": {
                  "type": "string"
                }
              }
            }
          },
          "depends_on": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "test_command": {
            "type": "string",
            "minLength": 3
          }
        }
      }
    }
  }
}
